# =============================================================================
# Claude Code Auth (Max subscription)
# =============================================================================
# Run 'claude setup-token' on a machine with a browser to get this token
# Token prefix: sk-ant-oat01-... (valid ~1 year)
# Uses your Claude Max subscription — no per-token API charges
CLAUDE_CODE_OAUTH_TOKEN=

# =============================================================================
# SDK API (for CI/CD integration)
# =============================================================================
SDK_API_KEY=
SDK_PORT=3100
ENABLE_SDK_API=false
# Max concurrent Claude Code tasks (prevents OOM under load)
MAX_CONCURRENT=3

# =============================================================================
# Git
# =============================================================================
GIT_USER_NAME=Tri Gunawan
GIT_USER_EMAIL=tri@kodeme.io
# Personal Access Token (classic) — required scopes: repo, workflow, read:org
# Used by both gh CLI and git (push/pull/clone)
GITHUB_TOKEN=

# =============================================================================
# Hetzner / Dokploy paths
# =============================================================================
# Where repos are cloned on the server (scripts/setup.sh clones here)
REPOS_BASE_PATH=/opt/repos
# SSH deploy key path on the server
SSH_KEYS_PATH=/root/.ssh
# kctl-* credentials (deployed by: make sync-secrets)
# Contains config.yaml with API keys for all 11 kctl tools
SECRETS_PATH=/opt/kodemeio-claude-secrets

# MCP OAuth credentials (for Gmail, Notion, Linear, etc.)
# Auth on laptop first: claude → authenticate MCP servers in browser
# Then deploy: scp ~/.claude/.credentials.json root@dokploy.kodeme.io:/opt/kodemeio-claude-secrets/
CLAUDE_CREDENTIALS=

# =============================================================================
# KodeClaw Daemon (heartbeat, cron, Telegram, dashboard)
# =============================================================================
# Enable the daemon subsystems (heartbeat, cron, Telegram, dashboard)
ENABLE_DAEMON=false
# Telegram Bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Voice STT cascade: Groq (fastest) → OpenAI → local whisper.cpp
GROQ_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# Optional
# =============================================================================
# Enable network firewall (requires --cap-add=NET_ADMIN)
ENABLE_FIREWALL=false
# SSH target for secret deployment (used by scripts/sync-secrets.sh)
HETZNER_SSH=root@dokploy.kodeme.io
# GitHub organization for repo cloning (used by scripts/setup.sh)
GITHUB_ORG=kodemeio

# =============================================================================
# General
# =============================================================================
TZ=Asia/Jakarta
