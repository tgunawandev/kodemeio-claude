# =============================================================================
# .zshrc — kodemeio-claude development environment
# =============================================================================

# Welcome message (must be before p10k instant prompt to avoid console output warning)
if [ -z "$TMUX" ]; then
    echo "================================================================"
    echo "  kodemeio-claude — Remote Development Container"
    echo "  Companies: kodemeio | kontenos | journaltx | kidneuro"
    echo "  Use: tmux attach -t <company> or aliases (kd, kt, jt, kn)"
    echo "================================================================"
fi

# Powerlevel10k instant prompt (must be after any console output)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# History
HISTFILE=/commandhistory/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt APPEND_HISTORY

# Key bindings
bindkey -e
bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word
bindkey "^[[1;5A" beginning-of-line
bindkey "^[[1;5B" end-of-line

# Zap plugin manager + plugins
[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/zap/zap.zsh" ] && source "${XDG_DATA_HOME:-$HOME/.local/share}/zap/zap.zsh"
plug "zsh-users/zsh-autosuggestions"
plug "zsh-users/zsh-syntax-highlighting"

# Completions
autoload -Uz compinit
compinit
zstyle ':completion:*' menu select

# Powerlevel10k theme
[ -d ~/powerlevel10k ] && source ~/powerlevel10k/powerlevel10k.zsh-theme
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Aliases — company shortcuts
alias kd='cd /opt/dev/kodemeio-app'
alias kt='cd /opt/dev/kontenos-app'
alias jt='cd /opt/dev/journaltx-app'
alias kn='cd /opt/dev/kidneuro-app'
alias ki='cd /opt/dev/kodemeio-infra'
alias kc='cd /opt/dev/kodemeio-core'

# Development aliases
alias g='git'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline -20'
alias gp='git pull'

# Docker aliases
alias dc='docker compose'
alias dps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
alias dlogs='docker logs -f'

# Claude Code aliases
alias cc='claude'
alias ccr='claude --remote'

# Tool versions
alias versions='echo "Node: $(node -v) | pnpm: $(pnpm -v) | Python: $(python3 --version) | uv: $(uv --version) | Claude: $(claude --version 2>/dev/null || echo N/A)"'

# Path
export PATH="$HOME/.local/bin:$PATH"

# FZF integration
[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh
