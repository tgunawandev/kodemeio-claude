FROM node:22-bookworm-slim

ARG CLAUDE_CODE_VERSION=latest
ARG TZ=Asia/Jakarta

ENV TZ="$TZ"
ENV DEVCONTAINER=true
ENV TERM=xterm-256color
ENV PATH="/home/dev/.local/bin:/root/.local/bin:$PATH"

# Minimal dependencies for headless Claude Code
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates sudo \
    openssh-client jq gh ffmpeg \
    python3 python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install uv (Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Install pnpm
RUN npm install -g pnpm@latest

# Install Claude Code
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

# Create dev user with same UID/GID as host user (for bind mount permissions)
ARG DEV_UID=1000
ARG DEV_GID=1000
RUN groupadd -g ${DEV_GID} dev && \
    useradd -m -s /bin/bash -u ${DEV_UID} -g ${DEV_GID} -G sudo dev && \
    echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev

# Workspace
RUN mkdir -p /opt/dev /home/dev/.claude && \
    chown -R dev:dev /opt/dev /home/dev

# Copy SDK server — compile TypeScript then prune dev deps
COPY sdk/ /opt/sdk/
RUN cd /opt/sdk && npm install && npm run build && npm prune --omit=dev

# Copy config and entrypoint
COPY config/.claude/ /home/dev/.claude/
COPY docker/entrypoint-sdk.sh /usr/local/bin/

RUN chmod +x /usr/local/bin/entrypoint-sdk.sh && \
    chown -R dev:dev /home/dev /opt/sdk

USER dev
WORKDIR /opt/dev

EXPOSE 3100

ENTRYPOINT ["/usr/local/bin/entrypoint-sdk.sh"]
